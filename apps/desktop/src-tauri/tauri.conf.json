{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keytone",
  "version": "0.1.0",
  "identifier": "app.keytone.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Keytone",
        "width": 1080,
        "height": 720,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "category": "Music",
    "shortDescription": "Make every keystroke sound yours.",
    "longDescription": "A local-first, low-latency keyboard audio engine.",
    "copyright": "Copyright 2026 Keytone contributors",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
